# apps/realtime on Railway (service kaboom-realtime). NAMES ONLY: set values in the Railway dashboard.

# Railway Postgres private-network URL (same database as kaboom-web) as the kaboom_relay role
# (CONNECT only; db/roles.mjs creates it), never the postgres superuser. The relay LISTENs on
# channel kaboom_events. For the public TCP proxy append ?sslmode=no-verify. Secret.
DATABASE_URL=
# kaboom_relay's password (24+ letters/digits); referenced from DATABASE_URL. Secret.
KABOOM_RELAY_DB_PASSWORD=
# Comma-separated browser origins allowed to open the WS (default: playkaboom.gg, www, localhost:3000).
ALLOWED_ORIGINS=

# Cron tickler: the relay GETs CRON_TICK_URL every 60 s with "Authorization: Bearer CRON_TICK_AUTH".
# Set it to https://<kaboom-web host>/api/cron/tick (one URL); CRON_TICK_AUTH = the web's CRON_TICK_SECRET.
CRON_TICK_URL=
CRON_TICK_AUTH=

# Alchemy logsSubscribe push path + /rpc-ws proxy (secret: carries the API key).
ALCHEMY_WS_URL=
# The logsSubscribe filter is always Ednka8zjoYbE7T6iF9NHHXotaXCrbJn4Mta376cunhju (hard-coded);
# a KABOOM_PROGRAM_ID env value is ignored with a warning, so leave it unset.
# kaboom-web /api/ingest URL and its bearer (= the web's INGEST_SECRET).
INGEST_URL=
INGEST_AUTH=

# Provided by Railway, do not set: PORT.
# Gone: SUPABASE_URL, SUPABASE_ANON_KEY.
