# apps/web on Railway (service kaboom-web). NAMES ONLY: set values in the Railway dashboard.
# NEXT_PUBLIC_* are inlined into the browser bundle at BUILD time: never put a secret in one,
# and rebuild after changing one.

# ── Database ────────────────────────────────────────────────────────────
# Railway Postgres private-network URL (*.railway.internal, no TLS) as the kaboom_app role
# (not the template's postgres superuser; db/roles.mjs creates it). The pre-deploy migrate
# runs as it too. For the public TCP proxy append ?sslmode=no-verify. Secret: carries the DB password.
DATABASE_URL=
# kaboom_app's password (24+ letters/digits); referenced from DATABASE_URL. Secret.
KABOOM_APP_DB_PASSWORD=

# ── Chain (mainnet only) ────────────────────────────────────────────────
# Program ID (server). Optional: defaults to Ednka8zjoYbE7T6iF9NHHXotaXCrbJn4Mta376cunhju;
# any other value makes the server refuse to start a house tx.
PROGRAM_ID=
# Server Solana RPC URL (paid Alchemy mainnet URL; secret: carries the API key). Required, no default.
SOLANA_RPC=
# Upstream for the same-origin /api/rpc/mainnet proxy (secret: carries the API key).
SOLANA_MAINNET_RPC=
# Must equal vault.treasury on chain.
TREASURY_PUBKEY=

# ── House signer ────────────────────────────────────────────────────────
# Raw house keypair, base58 secret or JSON byte array. Its pubkey is vault.house_authority
# (pass only that pubkey to scripts/init-vault-mainnet.ts --house). Validated at boot: a missing
# or malformed key stops the server. Never logged, returned or sent to the browser.
HOUSE_SECRET_KEY=
# MagicBlock ER endpoint for the house's force_undelegate_vrf txs (F3). Optional when
# NEXT_PUBLIC_ER_RPC is set (same value, https://as.magicblock.app/); no default.
ER_RPC=
# AES key for legacy commit-reveal session ciphertext (game_sessions); still needed for wind-down.
SESSION_ENC_KEY=
# Server kill switch for the VRF money routes and the VRF cron passes; must be "true".
VRF_MODE_ENABLED=

# ── Auth ────────────────────────────────────────────────────────────────
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ── Cron / ingest / admin secrets ───────────────────────────────────────
# Bearer for GET /api/cron/tick (the one house scheduler); same value as the relay's CRON_TICK_AUTH.
CRON_TICK_SECRET=
# Bearer for /api/ingest; same value as the relay's INGEST_AUTH.
INGEST_SECRET=
ADMIN_BACKFILL_SECRET=
ADMIN_INDEX_RESET_SECRET=
ADMIN_RELEASE_SECRET=

# ── Optional ────────────────────────────────────────────────────────────
# Alerts webhook (Discord/Slack) and its format.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_FORMAT=
# Shared rate limiter; without it an in-process limiter is used (fine at 1 replica).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LOG_LEVEL=

# ── Browser (build time, public) ────────────────────────────────────────
# Passed to the Docker build as ARGs (apps/web/Dockerfile declares each one; a NEW
# NEXT_PUBLIC_* variable must be added there too or the bundle never sees it).
# "mainnet-beta".
NEXT_PUBLIC_SOLANA_CLUSTER=
# Optional, defaults to the relaunch program; any other value fails the build.
NEXT_PUBLIC_PROGRAM_ID=
# Privy app id (25 chars, same as PRIVY_APP_ID). Missing or malformed fails the build.
NEXT_PUBLIC_PRIVY_APP_ID=
# MagicBlock ER endpoints (https://as.magicblock.app/ and its wss).
NEXT_PUBLIC_ER_RPC=
NEXT_PUBLIC_ER_WS=
# wss://<kaboom-realtime host> (live feed). Also added to the CSP connect-src.
NEXT_PUBLIC_REALTIME_WS_URL=
# Optional MagicBlock VRF queue override; leave unset.
NEXT_PUBLIC_VRF_QUEUE=
# Optional: /api/version uses Railway's RAILWAY_DEPLOYMENT_ID first; this is only the fallback.
NEXT_PUBLIC_BUILD_ID=

# Provided by Railway, do not set: PORT, RAILWAY_DEPLOYMENT_ID.
# RETIRED at the 2026-11-04 relaunch. Do NOT carry these over or set them on Railway or Vercel:
#   Supabase (retired): SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, NEXT_PUBLIC_SUPABASE_URL,
#     NEXT_PUBLIC_SUPABASE_ANON_KEY. The database is Railway Postgres (DATABASE_URL above).
#   Turnkey (retired): TURNKEY_*, USE_TURNKEY. The house key is HOUSE_SECRET_KEY above, on Railway only.
#   HOUSE_AUTHORITY_KEY: old name of HOUSE_SECRET_KEY.
#   NEXT_PUBLIC_VRF_MODE_ENABLED: VRF is the only mode; it needs NEXT_PUBLIC_ER_RPC.
#   CRON_SECRET, HELIUS_WEBHOOK_AUTH: old shared bearers. Some admin/index routes still accept them
#     as a fallback, so setting one re-opens an old credential; the tick route accepts only CRON_TICK_SECRET.
#   VERCEL_*: Vercel's own system variables. Vercel now hosts only the frontend (KABOOM_API_ORIGIN,
#     see pinocchio/MIGRATION/DEPLOY.md); never copy its variables to Railway.
