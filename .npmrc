# Strict engines: refuse install on a Node version that doesn't match
# package.json `engines.node`. Keeps prod consistent with local + CI.
engine-strict=true

# Pin registry explicitly so a rogue .npmrc in a dependency cannot
# silently redirect installs.
registry=https://registry.npmjs.org/

# Don't auto-run install scripts from transitive deps without consent.
# (Note: workspace top-level scripts still run; this protects nested deps.)
# Uncomment if/when a postinstall is ever needed for a workspace pkg:
# ignore-scripts=false
