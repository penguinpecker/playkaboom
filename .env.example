# ── Solana ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
SOLANA_RPC=https://api.devnet.solana.com
PROGRAM_ID=Kab1TestProgam11111111111111111111111111111

# ── House operator ────────────────────────────────────────────────────────────
# JSON byte array, e.g. [12,34,...] (64 bytes for ed25519 secret key)
HOUSE_AUTHORITY_KEY=

# ── Session encryption ────────────────────────────────────────────────────────
# 64 hex chars = 32 bytes. Generate with: openssl rand -hex 32
SESSION_ENC_KEY=

# ── Privy ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PRIVY_APP_ID=

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: for Helius webhook auth (any string we generate; configure same value in Helius dashboard)
HELIUS_WEBHOOK_AUTH=

# ── Rate limiting (Upstash Redis) ─────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=info
