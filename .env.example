# ── Solana ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
SOLANA_RPC=https://api.devnet.solana.com
PROGRAM_ID=Kab1TestProgam11111111111111111111111111111

# ── House operator (Turnkey HSM) ──────────────────────────────────────────────
# Production signs every reveal/settle via Turnkey; the raw private key never
# touches env. Set USE_TURNKEY=true (default in prod) and provide the four
# TURNKEY_* values from your Turnkey dashboard.
TURNKEY_ORG_ID=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_HOUSE_PUBKEY=
USE_TURNKEY=true

# ── Session encryption ────────────────────────────────────────────────────────
# 64 hex chars = 32 bytes. Generate with: openssl rand -hex 32
SESSION_ENC_KEY=

# ── Privy ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PRIVY_APP_ID=
# Privy app secret — server-side only, used to verify auth tokens.
# Get from https://dashboard.privy.io → app settings → "App secret".
PRIVY_APP_SECRET=

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: for Helius webhook auth (any string we generate; configure same value in Helius dashboard)
HELIUS_WEBHOOK_AUTH=

# ── Rate limiting (Upstash Redis) ─────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=info

# ── VRF game mode (MagicBlock per-click VRF-in-Ephemeral-Rollup) ──────────────
# SERVER kill switch — the one that actually stops money moving. The VRF routes
# (settle / refund / settle cron) return 403 unless this is exactly "true", so a
# client flag alone can never expose them. Flips without a redeploy.
VRF_MODE_ENABLED=false
# Client flag. "true" routes the UI to the VRF mode; anything else keeps the
# commit-reveal flow. Inlined at BUILD time and purely cosmetic on its own —
# it does not gate any endpoint. Set VRF_MODE_ENABLED too.
NEXT_PUBLIC_VRF_MODE_ENABLED=false
# Ephemeral-rollup RPC/WS. These are REGIONAL NODES, not routers — despite the
# name, mainnet.magicblock.app is just an unlabelled alias for the Singapore
# node (as.magicblock.app).
#
# ⚠️ ON MAINNET THESE ARE REQUIRED, and must name the SAME node as the on-chain
# v2_state.vrf_validator pin. Only the pinned validator can commit or undelegate
# a game; if the app talks to a different node, delegation still succeeds and
# the game is stranded with the player's bet locked. It fails silently.
# Devnet/testnet fall back to devnet.magicblock.app; mainnet has no default.
#
# Mainnet roster (verify: curl -s -X POST https://router.magicblock.app \
#   -H 'Content-Type: application/json' -d '{"jsonrpc":"2.0","id":1,"method":"getRoutes"}'):
#   MAS1Dt9qreoRMQ14YQuhg8UTZMMzDdKhmkZMECCzk57 -> https://as.magicblock.app/           (Singapore)
#   MTEWGuqxUpYZGFJQcp8tLN7x5v9BSeoFHYWQQ3n3xzo -> https://mainnet-tee.magicblock.app/  (Singapore, TEE-attested)
#   MEUG… -> EU   MUS3… -> US
NEXT_PUBLIC_ER_RPC=
NEXT_PUBLIC_ER_WS=
# Ephemeral VRF oracle queue. Program-wide constant, same on devnet + mainnet
# (5hBR571xnXppuCPveTrctfTU7tJLSN94nq7kv7FRK5Tc). Set only if MagicBlock rotates it.
NEXT_PUBLIC_VRF_QUEUE=
# The house wallet (HOUSE_AUTHORITY_KEY / Turnkey) drives settle_vrf + refund and
# pays only those fees. It does NOT sponsor session keys: the player funds their
# own ephemeral session key inside the start transaction, so there is no endpoint
# that pays out house SOL on request. The settle cron (/api/cron/vrf-settle,
# scheduled in vercel.json) uses CRON_TICK_SECRET.
